<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="../GoF2InputGlyphs.uss" />
    <ui:Style src="StationMenu.uss" />
    <ui:Style src="HangarWindow.uss" />
    <ui:VisualElement name="stationRoot" class="station-root" picking-mode="Ignore">
        <ui:VisualElement class="side-shade" picking-mode="Ignore" />
        <ui:VisualElement class="bottom-shade" picking-mode="Ignore" />
        <ui:VisualElement name="dragZone" class="drag-zone" />
        <ui:VisualElement name="safeArea" class="station-safe" picking-mode="Ignore">
            <ui:VisualElement class="top-bar" picking-mode="Ignore">
                <ui:Label name="stationTitle" class="station-title gof-semibold" picking-mode="Ignore" />
                <ui:Label name="viewTitle" class="view-title" picking-mode="Ignore" />
                <ui:Button name="menuButton" class="station-menu-button gof-semibold" />
            </ui:VisualElement>

            <ui:VisualElement name="sidePanel" class="side-panel" picking-mode="Ignore">
                <ui:VisualElement class="station-info" picking-mode="Ignore">
                    <ui:Label name="systemName" class="info-system gof-semibold" picking-mode="Ignore" />
                    <ui:Label name="techLevel" class="info-line" picking-mode="Ignore" />
                    <ui:Label name="raceName" class="info-line" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="station-buttons" picking-mode="Ignore">
                    <ui:Button name="hangarButton" class="station-button gof-semibold" />
                    <ui:Button name="loungeButton" class="station-button gof-semibold" />
                    <ui:Button name="mapButton" class="station-button gof-semibold" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Button name="launchButton" class="launch-button gof-semibold" />

            <ui:VisualElement name="hangarWindow" class="hangar-window">
                <ui:VisualElement class="hangar-top">
                    <ui:Button name="tabShip" class="hangar-tab gof-semibold" />
                    <ui:Button name="tabShop" class="hangar-tab gof-semibold" />
                    <ui:VisualElement class="hangar-top-spacer" picking-mode="Ignore" />
                    <ui:Button name="hangarClose" class="hangar-close gof-semibold" />
                </ui:VisualElement>
                <ui:VisualElement class="hangar-body" picking-mode="Ignore">
                    <ui:ScrollView name="hangarList" class="hangar-list" />
                    <ui:VisualElement name="hangarDetails" class="hangar-details">
                        <ui:VisualElement class="detail-head" picking-mode="Ignore">
                            <ui:VisualElement name="detailIcon" class="detail-icon" picking-mode="Ignore" />
                            <ui:VisualElement class="detail-titles" picking-mode="Ignore">
                                <ui:Label name="detailName" class="detail-name gof-semibold" picking-mode="Ignore" />
                                <ui:Label name="detailSub" class="detail-sub" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="tradeBox" class="trade-box">
                            <ui:VisualElement class="trade-side" picking-mode="Ignore">
                                <ui:Label name="tradeStockLabel" class="trade-side-label" picking-mode="Ignore" />
                                <ui:Label name="tradeStock" class="trade-side-value gof-semibold" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="sellButton" class="trade-arrow">
                                <ui:Label name="sellLabel" class="trade-arrow-label gof-semibold" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:Label name="tradePrice" class="trade-price gof-semibold" picking-mode="Ignore" />
                            <ui:VisualElement name="buyButton" class="trade-arrow trade-arrow--buy">
                                <ui:Label name="buyLabel" class="trade-arrow-label gof-semibold" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="trade-side trade-side--right" picking-mode="Ignore">
                                <ui:Label name="tradeCargoLabel" class="trade-side-label" picking-mode="Ignore" />
                                <ui:Label name="tradeCargo" class="trade-side-value gof-semibold" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Button name="actionButton" class="detail-action gof-semibold" />
                        <ui:ScrollView name="detailScroll" class="detail-scroll">
                            <ui:VisualElement name="detailStats" class="detail-stats" picking-mode="Ignore" />
                            <ui:Label name="detailText" class="detail-text" picking-mode="Ignore" />
                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="hangar-footer" picking-mode="Ignore">
                    <ui:Label name="cargoLabel" class="footer-cargo gof-semibold" picking-mode="Ignore" />
                    <ui:Label name="creditsLabel" class="footer-credits gof-semibold" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="hints" class="station-hints" picking-mode="Ignore" />
            <ui:Label name="toast" class="station-toast" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="systemMenu" class="station-dialog-backdrop">
            <ui:VisualElement class="system-menu">
                <ui:Label name="systemMenuTitle" class="system-menu-title gof-semibold" />
                <ui:VisualElement name="systemMenuMain" class="system-menu-page">
                    <ui:Button name="saveGameButton" class="station-button gof-semibold" />
                    <ui:Button name="mainMenuButton" class="station-button gof-semibold" />
                    <ui:Button name="systemMenuClose" class="station-button gof-semibold" />
                </ui:VisualElement>
                <ui:VisualElement name="systemMenuSave" class="system-menu-page">
                    <ui:ScrollView name="saveSlotList" class="slot-list system-slot-list" />
                    <ui:Button name="saveBack" class="station-button system-menu-back gof-semibold" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="dialog" class="station-dialog-backdrop">
            <ui:VisualElement class="station-dialog">
                <ui:Label name="dialogText" class="station-dialog-text" />
                <ui:VisualElement class="station-dialog-buttons">
                    <ui:Button name="dialogYes" class="station-button station-dialog-button gof-semibold" />
                    <ui:Button name="dialogNo" class="station-button station-dialog-button gof-semibold" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
