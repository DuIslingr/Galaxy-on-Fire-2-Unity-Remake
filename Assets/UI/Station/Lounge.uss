/* Space Lounge (GoF2LoungePanel) and the Missions window (GoF2MissionsWindow) over the station screen.
   The root gets lounge-open while the bar is shown (intro over), chat-open while talking to an agent and missions-open
   while the Missions window is up. Panel units at 1920x1080. */

/* ---- visitor name tags over the 3D billboards (positioned in code) ----------------------------- */

.lounge-tags {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.lounge-open .lounge-tags {
    display: flex;
}

.chat-open .lounge-tags,
.missions-open .lounge-tags,
.station-map-open .lounge-tags {
    display: none;
}

.lounge-tag {
    position: absolute;
    translate: -50% -100%;
    padding: 6px 14px;
    background-color: rgba(4, 10, 18, 0.72);
    border-width: 1px;
    border-color: var(--gof-cyan-soft);
    border-radius: 4px;
    flex-direction: row;
    align-items: center;
}

.lounge-tag--selected {
    border-color: var(--gof-amber);
    background-color: rgba(40, 26, 6, 0.8);
}

.lounge-tag-name {
    font-size: 20px;
    letter-spacing: 1px;
    color: #FFFFFF;
}

.lounge-tag-mark {
    width: 12px;
    height: 12px;
    margin-left: 8px;
    border-radius: 6px;
    background-color: var(--gof-amber);
}

.lounge-tag-mark--known {
    background-color: var(--gof-text-disabled);
}

/* ---- visitor list (right side) ------------------------------------------------------------ */

.lounge-list {
    display: none;
    position: absolute;
    right: 40px;
    top: 120px;
    width: 420px;
}

.lounge-open .lounge-list {
    display: flex;
}

.chat-open .lounge-list,
.missions-open .lounge-list {
    display: none;
}

.lounge-row {
    flex-direction: row;
    align-items: center;
    margin: 3px 0;
    padding: 10px 16px;
    background-color: rgba(4, 10, 18, 0.55);
    border-width: 0;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    transition-duration: 0.15s;
}

.can-hover .lounge-row:hover,
.lounge-row:focus,
.lounge-row--selected {
    border-left-color: var(--gof-amber);
    background-color: var(--gof-cyan-faint);
    translate: -10px 0;
}

.lounge-row-titles {
    flex-grow: 1;
}

.lounge-row-name {
    font-size: 22px;
    color: #FFFFFF;
}

.lounge-row-sub {
    font-size: 16px;
    color: var(--gof-text-dim);
}

/* ---- chat window ------------------------------------------------------------------------- */

.chat-window {
    display: none;
    position: absolute;
    left: 520px;
    right: 40px;
    bottom: 110px;
    max-height: 820px;
    background-color: var(--gof-panel);
    border-width: 1px;
    border-color: var(--gof-line);
    border-top-width: 3px;
    border-top-color: var(--gof-cyan);
}

.chat-open .chat-window {
    display: flex;
}

.chat-open .station-buttons,
.missions-open .station-buttons,
.missions-open .launch-button,
.chat-open .launch-button {
    display: none;
}

.chat-header {
    flex-direction: row;
    align-items: center;
    padding: 12px 18px 10px 20px;
    background-color: rgba(62, 200, 255, 0.08);
    border-bottom-width: 1px;
    border-bottom-color: var(--gof-line);
}

.chat-titles {
    flex-grow: 1;
}

.chat-name {
    font-size: 24px;
    letter-spacing: 3px;
    color: #FFFFFF;
}

.chat-sub {
    font-size: 16px;
    letter-spacing: 1px;
    color: var(--gof-text-dim);
}

.chat-body {
    flex-direction: row;
    padding: 16px 20px 0 16px;
    flex-shrink: 1;
}

.chat-portrait {
    margin-right: 20px;
}

.chat-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 200px;
    max-height: 360px;
}

.chat-text {
    white-space: normal;
    font-size: 23px;
    color: var(--gof-text);
}

.chat-choices {
    padding: 12px 20px 16px 196px;
}

.chat-choice {
    margin: 2px 0;
    padding: 10px 18px;
    font-size: 21px;
    letter-spacing: 1px;
}

/* ---- missions window --------------------------------------------------------------------- */

.missions-window {
    display: none;
    position: absolute;
    left: 520px;
    right: 40px;
    top: 120px;
    bottom: 110px;
    background-color: var(--gof-panel);
    border-width: 1px;
    border-color: var(--gof-line);
    border-top-width: 3px;
    border-top-color: var(--gof-amber);
}

.missions-open .missions-window {
    display: flex;
}

.missions-body {
    flex-grow: 1;
    flex-direction: row;
    padding: 20px;
}

.missions-main {
    flex-grow: 1;
}

.missions-main .chat-scroll {
    max-height: none;
    margin-top: 10px;
}

.missions-footer {
    flex-direction: row;
    justify-content: flex-end;
    padding: 10px 20px 16px 20px;
}

.missions-footer .chat-choice {
    margin-left: 12px;
}

.missions-discard {
    color: #FF6A5A;
}

.portrait-hidden {
    display: none;
}

/* Phones: the side panel is narrower. */
.layout-phone .chat-window,
.layout-phone .missions-window {
    left: 450px;
}
