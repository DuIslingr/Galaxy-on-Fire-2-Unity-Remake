/* In-flight HUD. The root gets input-touch / input-keyboard / input-gamepad from GoF2FlightHud (GoF2InputMode):
   touch controls only show for touch, the hint row only for keyboard and controller. Panel units at 1920x1080
   (1600x900 on phones, so everything is relatively bigger there). */

.hud {
    flex-grow: 1;
}

.hud-safe {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* ---- touch controls ------------------------------------------------------------------ */

.touch-layer {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: row;
}

.input-touch .touch-layer {
    display: flex;
}

.stick-zone {
    width: 50%;
    height: 100%;
}

.stick-ghost {
    position: absolute;
    left: 90px;
    bottom: 90px;
    width: 220px;
    height: 220px;
    border-radius: 110px;
    border-width: 2px;
    border-color: var(--gof-cyan-soft);
    background-color: rgba(62, 200, 255, 0.05);
    align-items: center;
    justify-content: center;
    transition-duration: 0.2s;
}

.stick-ghost--hidden {
    opacity: 0;
}

.stick-base {
    position: absolute;
    width: 220px;
    height: 220px;
    border-radius: 110px;
    border-width: 3px;
    border-color: var(--gof-cyan-soft);
    background-color: rgba(4, 10, 18, 0.35);
    align-items: center;
    justify-content: center;
    opacity: 0;
}

.stick-base--active {
    opacity: 1;
}

.stick-knob {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    background-color: var(--gof-cyan-soft);
    border-width: 3px;
    border-color: var(--gof-cyan);
}

.touch-right {
    flex-grow: 1;
    flex-direction: row;
    justify-content: flex-end;
    align-items: flex-end;
    padding: 0 40px 70px 0;
}

.touch-buttons {
    align-items: center;
    margin-right: 36px;
}

.touch-button {
    width: 170px;
    height: 170px;
    border-radius: 85px;
    border-width: 3px;
    border-color: var(--gof-cyan-soft);
    background-color: rgba(4, 10, 18, 0.45);
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition-duration: 0.1s;
}

.touch-button--small {
    width: 120px;
    height: 120px;
    border-radius: 60px;
    margin-bottom: 28px;
}

.touch-button--pressed {
    background-color: var(--gof-amber-soft);
    border-color: var(--gof-amber);
    scale: 0.94 0.94;
}

.touch-button--disabled {
    opacity: 0.4;
}

.boost-charge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
    background-color: rgba(62, 200, 255, 0.18);
}

.touch-button-label {
    font-size: 22px;
    letter-spacing: 2px;
    color: var(--gof-text);
}

.touch-caption {
    font-size: 18px;
    letter-spacing: 3px;
    color: var(--gof-text-dim);
}

.throttle-track {
    width: 78px;
    height: 420px;
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--gof-cyan-soft);
    background-color: rgba(4, 10, 18, 0.45);
    overflow: hidden;
}

.throttle-fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100%;
    background-color: rgba(62, 200, 255, 0.22);
}

.throttle-handle {
    position: absolute;
    left: 6px;
    right: 6px;
    bottom: 100%;
    height: 10px;
    margin-bottom: -5px;
    border-radius: 5px;
    background-color: var(--gof-cyan);
}

/* ---- speed / throttle / boost readout ------------------------------------------------- */

.speed-panel {
    position: absolute;
    left: 40px;
    top: 34px;
    width: 260px;
    padding: 12px 16px;
    background-color: rgba(4, 10, 18, 0.55);
    border-left-width: 3px;
    border-left-color: var(--gof-cyan);
}

.speed-row {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 8px;
}

.speed-value {
    font-size: 40px;
    color: #FFFFFF;
    -unity-text-align: lower-left;
}

.speed-unit {
    font-size: 18px;
    color: var(--gof-text-dim);
    margin: 0 0 7px 8px;
}

.bar {
    height: 6px;
    margin-top: 5px;
    background-color: rgba(255, 255, 255, 0.1);
}

.bar-fill {
    height: 100%;
    width: 100%;
    background-color: var(--gof-cyan);
}

.bar-fill--boost {
    background-color: var(--gof-amber);
}

/* ---- menu button (touch) --------------------------------------------------------------- */

.hud-menu-button {
    display: none;
    position: absolute;
    right: 40px;
    top: 34px;
    padding: 12px 22px;
    font-size: 20px;
    letter-spacing: 3px;
    color: var(--gof-text);
    background-color: rgba(4, 10, 18, 0.55);
    border-width: 2px;
    border-color: var(--gof-cyan-soft);
    border-radius: 4px;
}

.input-touch .hud-menu-button {
    display: flex;
}

/* ---- keyboard / controller hints -------------------------------------------------------- */

.hints {
    display: none;
    position: absolute;
    left: 40px;
    bottom: 34px;
    align-items: flex-start;
}

.input-keyboard .hints,
.input-gamepad .hints {
    display: flex;
}

.hint {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    padding: 6px 12px;
    background-color: rgba(4, 10, 18, 0.5);
    border-radius: 4px;
}

.hint-label {
    font-size: 17px;
    letter-spacing: 2px;
    color: var(--gof-text-dim);
    margin-left: 10px;
}

.keycap {
    min-width: 34px;
    height: 34px;
    padding: 0 8px;
    margin: 0 2px;
    font-size: 16px;
    color: var(--gof-text);
    -unity-text-align: middle-center;
    border-width: 2px;
    border-bottom-width: 4px;
    border-color: rgba(216, 236, 247, 0.45);
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.06);
}

.keycap--wide {
    min-width: 110px;
}

.pad-face {
    width: 36px;
    height: 36px;
    margin: 0 2px;
    border-radius: 18px;
    font-size: 18px;
    color: #0B1016;
    -unity-text-align: middle-center;
}

.pad-face--a {
    background-color: #6BC24A;
}

.pad-face--y {
    background-color: #F2C230;
}

.pad-stick {
    width: 40px;
    height: 40px;
    margin: 0 2px;
    border-radius: 20px;
    border-width: 3px;
    border-color: rgba(216, 236, 247, 0.6);
    font-size: 13px;
    color: var(--gof-text);
    -unity-text-align: middle-center;
}

.pad-trigger {
    min-width: 42px;
    height: 32px;
    padding: 0 6px;
    margin: 0 2px;
    border-radius: 6px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    background-color: rgba(216, 236, 247, 0.85);
    font-size: 14px;
    color: #0B1016;
    -unity-text-align: middle-center;
}

.pad-menu {
    height: 30px;
    padding: 0 10px;
    margin: 0 2px;
    border-radius: 15px;
    background-color: rgba(216, 236, 247, 0.85);
    font-size: 12px;
    letter-spacing: 1px;
    color: #0B1016;
    -unity-text-align: middle-center;
}

/* Phones: a bit more room at the bottom for thumbs, smaller readout. */
.layout-phone .speed-panel {
    width: 220px;
}
