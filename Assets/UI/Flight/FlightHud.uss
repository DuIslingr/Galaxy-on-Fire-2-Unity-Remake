/* In-flight HUD. The root gets input-touch / input-keyboard / input-gamepad from GoF2FlightHud (GoF2InputMode):
   touch controls only show for touch, the hint row only for keyboard and controller. Panel units at 1920x1080
   (1600x900 on phones, so everything is relatively bigger there). */

.hud {
    flex-grow: 1;
}

.hud-safe {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* ---- touch controls ------------------------------------------------------------------ */

.touch-layer {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: row;
}

.input-touch .touch-layer {
    display: flex;
}

.stick-zone {
    width: 50%;
    height: 100%;
}

.stick-ghost {
    position: absolute;
    left: 90px;
    bottom: 90px;
    width: 220px;
    height: 220px;
    border-radius: 110px;
    border-width: 2px;
    border-color: var(--gof-cyan-soft);
    background-color: rgba(62, 200, 255, 0.05);
    align-items: center;
    justify-content: center;
    transition-duration: 0.2s;
}

.stick-ghost--hidden {
    opacity: 0;
}

.stick-base {
    position: absolute;
    width: 220px;
    height: 220px;
    border-radius: 110px;
    border-width: 3px;
    border-color: var(--gof-cyan-soft);
    background-color: rgba(4, 10, 18, 0.35);
    align-items: center;
    justify-content: center;
    opacity: 0;
}

.stick-base--active {
    opacity: 1;
}

.stick-knob {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    background-color: var(--gof-cyan-soft);
    border-width: 3px;
    border-color: var(--gof-cyan);
}

.touch-right {
    flex-grow: 1;
    flex-direction: row;
    justify-content: flex-end;
    align-items: flex-end;
    padding: 0 40px 70px 0;
}

.touch-buttons {
    align-items: center;
    margin-right: 36px;
}

.touch-button {
    width: 170px;
    height: 170px;
    border-radius: 85px;
    border-width: 3px;
    border-color: var(--gof-cyan-soft);
    background-color: rgba(4, 10, 18, 0.45);
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition-duration: 0.1s;
}

.touch-button--small {
    width: 120px;
    height: 120px;
    border-radius: 60px;
    margin-bottom: 28px;
}

.touch-button--fire {
    width: 210px;
    height: 210px;
    border-radius: 105px;
    border-color: rgba(255, 166, 48, 0.55);
}

.touch-button--hidden {
    display: none;
}

.touch-button-label--small {
    font-size: 17px;
}

.touch-button-count {
    font-size: 26px;
    color: #FFFFFF;
}

.touch-button--pressed {
    background-color: var(--gof-amber-soft);
    border-color: var(--gof-amber);
    scale: 0.94 0.94;
}

.touch-button--disabled {
    opacity: 0.4;
}

.boost-charge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
    background-color: rgba(62, 200, 255, 0.18);
}

.touch-button-label {
    font-size: 22px;
    letter-spacing: 2px;
    color: var(--gof-text);
}

.touch-caption {
    font-size: 18px;
    letter-spacing: 3px;
    color: var(--gof-text-dim);
}

.throttle-track {
    width: 78px;
    height: 420px;
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--gof-cyan-soft);
    background-color: rgba(4, 10, 18, 0.45);
    overflow: hidden;
}

.throttle-fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100%;
    background-color: rgba(62, 200, 255, 0.22);
}

.throttle-handle {
    position: absolute;
    left: 6px;
    right: 6px;
    bottom: 100%;
    height: 10px;
    margin-bottom: -5px;
    border-radius: 5px;
    background-color: var(--gof-cyan);
}

/* ---- crosshair (screen projection of ship + forward * 22000 units) ---------------------------- */

.crosshair {
    position: absolute;
    width: 64px;
    height: 64px;
    margin-left: -32px;
    margin-top: -32px;
    background-image: url("project://database/Assets/UI/Flight/Images/crosshair.png");
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.9;
}

.crosshair--hit {
    background-image: url("project://database/Assets/UI/Flight/Images/crosshair_hit.png");
}

.crosshair--hidden {
    display: none;
}

/* ---- dock prompt (inside the station's dock range, GoF2SpaceLevel.CanDock) ---------------- */

.dock-prompt {
    position: absolute;
    top: 120px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    padding: 14px 28px;
    background-color: rgba(4, 10, 18, 0.6);
    border-width: 2px;
    border-color: var(--gof-cyan);
    border-radius: 4px;
}

.dock-prompt--hidden {
    display: none;
}

.dock-glyph {
    flex-direction: row;
    margin-right: 12px;
}

.input-touch .dock-glyph {
    display: none;
}

.dock-label {
    font-size: 24px;
    letter-spacing: 5px;
    color: #FFFFFF;
}

/* ---- asteroid lock (GoF2MiningView) and HUD messages ------------------------------------ */

.lock-ring {
    display: none;
    position: absolute;
    width: 80px;
    height: 80px;
    margin-left: -40px;
    margin-top: -40px;
}

.lock-ring--shown {
    display: flex;
}

.lock-plate {
    display: none;
    position: absolute;
    top: 6px;
    left: 50%;
    width: 408px;
    height: 57px;
    margin-left: -204px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.lock-plate--shown {
    display: flex;
}

.lock-class {
    margin-right: 10px;
}

.lock-ore {
    font-size: 22px;
    color: #FFFFFF;
}

.hud-messages {
    position: absolute;
    top: 196px;
    left: 50%;
    width: 900px;
    margin-left: -450px;
    align-items: center;
}

.hud-message {
    margin-top: 4px;
    padding: 6px 16px;
    font-size: 20px;
    color: #FFFFFF;
    background-color: rgba(4, 10, 18, 0.6);
    border-radius: 3px;
    transition-duration: 0.4s;
}

.hud-message--fade {
    opacity: 0;
}

/* ---- mining minigame (full screen, under the touch controls) ------------------------------ */

.mining {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.mining--shown {
    display: flex;
}

.mining-ore {
    position: absolute;
    width: 108px;
    height: 45px;
    font-size: 22px;
    -unity-text-align: middle-center;
}

/* Autopilot to an asteroid and mining: no crosshair or weapon / flight buttons; the stick stays for the drill. */
.hud-docking .crosshair,
.hud-docking .touch-buttons,
.hud-docking .throttle-track {
    display: none;
}

.hud-docking .stick-zone {
    visibility: hidden;
}

.hud-mining .stick-zone {
    visibility: visible;
}

/* ---- speed / throttle / boost readout ------------------------------------------------- */

.speed-panel {
    position: absolute;
    left: 40px;
    top: 34px;
    width: 260px;
    padding: 12px 16px;
    background-color: rgba(4, 10, 18, 0.55);
    border-left-width: 3px;
    border-left-color: var(--gof-cyan);
}

.speed-row {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 8px;
}

.speed-value {
    font-size: 40px;
    color: #FFFFFF;
    -unity-text-align: lower-left;
}

.speed-unit {
    font-size: 18px;
    color: var(--gof-text-dim);
    margin: 0 0 7px 8px;
}

.bar {
    height: 6px;
    margin-top: 5px;
    background-color: rgba(255, 255, 255, 0.1);
}

.bar-fill {
    height: 100%;
    width: 100%;
    background-color: var(--gof-cyan);
}

.bar-fill--boost {
    background-color: var(--gof-amber);
}

/* ---- menu button (touch) --------------------------------------------------------------- */

.hud-menu-button {
    display: none;
    position: absolute;
    right: 40px;
    top: 34px;
    padding: 12px 22px;
    font-size: 20px;
    letter-spacing: 3px;
    color: var(--gof-text);
    background-color: rgba(4, 10, 18, 0.55);
    border-width: 2px;
    border-color: var(--gof-cyan-soft);
    border-radius: 4px;
}

.input-touch .hud-menu-button {
    display: flex;
}

/* ---- keyboard / controller hints -------------------------------------------------------- */

.hints {
    display: none;
    position: absolute;
    left: 40px;
    bottom: 34px;
    align-items: flex-start;
}

.input-keyboard .hints,
.input-gamepad .hints {
    display: flex;
}

/* Phones: a bit more room at the bottom for thumbs, smaller readout. */
.layout-phone .speed-panel {
    width: 220px;
}
