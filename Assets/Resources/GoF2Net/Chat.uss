/* Remake: the lines (full width, no gaps), the tab and the input row are solid: the chat is drawn over the flight HUD's
   key hints on the left and covers them while it shows (at even 95 % the bright hint text showed through). */

.chat {
    position: absolute;
    left: 24px;
    top: 36%;
    width: 560px;
}

.chat-tab {
    align-self: flex-start;
    padding: 3px 10px;
    margin-bottom: 6px;
    font-size: 14px;
    letter-spacing: 1px;
    color: rgba(216, 236, 247, 0.75);
    background-color: rgb(4, 8, 14);
    border-radius: 2px;
}

.chat-line {
    align-self: stretch;   /* the full width, no gaps: one block that covers the key hints under it */
    margin-bottom: 0;
    padding: 3px 8px;
    font-size: 17px;
    color: rgb(230, 240, 246);
    white-space: normal;
    background-color: rgb(4, 8, 14);
    border-radius: 2px;
}

.chat-line--own {
    color: rgb(255, 255, 255);
}

.chat-line--notice {
    color: rgba(216, 236, 247, 0.65);
    -unity-font-style: italic;
}

.chat-input-row {
    display: none;
    flex-direction: row;
    margin-top: 6px;
}

.chat--open .chat-input-row {
    display: flex;
}

.chat-channel {
    min-width: 96px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin: 0;
    padding: 4px 10px;
    font-size: 14px;
    color: rgb(143, 216, 255);
    background-color: rgb(4, 8, 14);
    border-width: 1px;
    border-color: rgba(143, 216, 255, 0.5);
    border-radius: 2px;
}

.chat-channel--global {
    color: rgb(240, 179, 90);
    border-color: rgba(240, 179, 90, 0.5);
}

.chat-field {
    flex-grow: 1;
    margin: 0 0 0 6px;
}

.chat-field .unity-base-text-field__input {
    padding: 5px 10px;
    font-size: 17px;
    color: rgb(255, 255, 255);
    background-color: rgb(4, 8, 14);
    border-width: 1px;
    border-color: rgba(216, 236, 247, 0.3);
    border-radius: 2px;
}
